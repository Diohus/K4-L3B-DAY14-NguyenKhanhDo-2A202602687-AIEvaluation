# Used only by domain_assistant.py when generating real RAG answers.
# Copy this file to .env, then replace the placeholder value.
# Create a key in Google AI Studio with a Free Tier project.
GENERATOR_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# To use the original OpenAI generator instead, set GENERATOR_PROVIDER=openai
# and add OPENAI_API_KEY and OPENAI_MODEL to .env.
